	note = {arXiv:1301.7321 [cs.LO]},
	keywords = {Computer Science - Logic in Computer Science},
	annote = {Comment: Non-reviewed version, original version submitted to CAV 2013; this is a revised version, containing more experimental results and some corrections},
	file = {Preprint PDF:/Users/michael.dyer/Zotero/storage/M2CFA8Y2/Kloos et al. - 2013 - Incremental, Inductive Coverability.pdf:application/pdf;Snapshot:/Users/michael.dyer/Zotero/storage/D54GVEIP/1301.html:text/html},
}

