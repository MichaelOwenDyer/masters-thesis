	note = {Series Title: Lecture Notes in Computer Science},
	pages = {70--87},
	file = {PDF:/Users/michael.dyer/Zotero/storage/PNUXTXUK/Bradley - 2011 - SAT-Based Model Checking Without Unrolling.pdf:application/pdf},
}

