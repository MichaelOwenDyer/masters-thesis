    "why": {"Q0": "3 markings, one enabled transition in each = 3 edges", "Q1": "the token always enables the next transition", "Q2": "token sum is invariant (1)", "Q3": "every transition fires on every lap", "Q4": "same", "Q5": "token sum 1", "Q6": "each place is 1 in one marking and 0 in another"},
    "targets": [
      {"kind": "QR", "marking": [0,1,0], "expected": true, "why": "fire t0"},
      {"kind": "QR", "marking": [1,1,0], "expected": false, "why": "token sum would be 2, invariant is 1"},
      {"kind": "QC", "marking": [0,0,1], "expected": true, "why": "reachable (t0 t1), so covered"},
      {"kind": "QC", "marking": [0,1,1], "expected": false, "why": "needs two tokens, sum is 1"}]},
